# ── Task Manager API — environment variables ─────────────────────────────
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored; this `.env.example` is safe to commit.
# Never commit real credentials.

# Port the API listens on (the Vite dev proxy targets http://localhost:5000).
PORT=5000

# MongoDB connection string.
# Local:    mongodb://127.0.0.1:27017/task-manager
# Atlas:    mongodb+srv://USER:PASSWORD@cluster.mongodb.net/task-manager
MONGO_URI=mongodb://127.0.0.1:27017/task-manager

# Secret used to sign JWT access tokens (any long random string).
JWT_SECRET=change-me-to-a-long-random-string

# ── Email (nodemailer / Gmail SMTP) ──────────────────────────────────────
# Used for the welcome email (Fig 6) and the password-reset OTP email (Fig 9).
# For Gmail, use an App Password (not your normal password).
# If unset, the API falls back to an Ethereal test account (logs a preview URL).
EMAIL_USER=
EMAIL_PASS=
# Optional display name for outgoing mail.
EMAIL_FROM_NAME=Task Manager

# ── Google Sign-In (Fig 5) ───────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console → Credentials.
# Must match the client ID passed to the frontend (VITE_GOOGLE_CLIENT_ID).
# If unset, POST /auth/google returns 503 "not configured".
GOOGLE_CLIENT_ID=

# ── AI Task Assistant (Google Gemini) ────────────────────────────────────
# Powers POST /ai/suggest-description ("AI Suggest" button in the task form).
# Get a key at https://aistudio.google.com/apikey
# SECURITY: this key is backend-only. Never prefix it with VITE_ and never
# put it in the frontend .env — the browser must never see it.
GEMINI_API_KEY=
# Optional: OpenAI (paid) — tried after Gemini and Groq
OPENAI_API_KEY=
# Optional: Groq — FREE tier, no credit card needed. Get a key at
# https://console.groq.com/keys (sign in with Google/GitHub → Create API Key)
GROQ_API_KEY=
# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=15000
