# ── Frontend environment variables (Vite) ─────────────────────────────
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored; this `.env.example` is safe to commit.
#
# VITE_ prefixed vars are exposed to the browser bundle, so ONLY put
# public, non-sensitive values here. Never put API keys or private tokens.

# Your Formspree form endpoint (Settings → Forms → Integrations, or the
# auto-generated endpoint shown when you create a form).
# Format: https://formspree.io/f/YOUR_FORM_ID
# Leave empty to disable real sending (the form will show a setup notice).
VITE_FORMSPREE_ENDPOINT=

# ── Google Sign-In (Task Manager) ────────────────────────────────────
# Public OAuth 2.0 Client ID from Google Cloud Console → Credentials.
# The "Continue with Google" button only appears when this is set.
VITE_GOOGLE_CLIENT_ID=
